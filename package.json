{
  "name": "temple-bei",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "db:generate": "drizzle-kit generate",
    "test:auth": "node --test tests/auth.test.mjs",
    "dev:local": "npm run build && wrangler dev --local --config wrangler.local.jsonc",
    "db:local": "npm run build && wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "drizzle-orm": "^0.45.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.7.0",
    "vite": "6.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "wrangler": "^4.0.0"
  }
}
