{
  "name": "temple-bei-local",
  "main": "worker/local.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "./dist/client", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "temple-bei-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "drizzle"}],
  "vars": {"LOCAL_DEVELOPMENT": "enabled", "ADMIN_EMAIL": "local-admin@example.test"}
}
